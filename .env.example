# PostgreSQL (required) — self-hosted Arteloka example
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bpbd_bitung

# Optional: enable TLS to the database (default: off)
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# Optional: pool size for serverless (default: 3)
# DB_POOL_MAX=3

# JWT signing secret for admin sessions (required in production)
JWT_SECRET=replace-with-a-long-random-string

# Vercel Blob — create a Blob store in the Vercel dashboard and connect it
# Prefer project connection (OIDC + BLOB_STORE_ID). For local/CI also add:
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Only used by scripts/init-db.js when creating the first admin user
# ADMIN_INITIAL_PASSWORD=your-strong-password
